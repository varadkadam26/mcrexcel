<%- include('../partials/header') %>

  <section style="background: var(--bg-cream); padding: 4rem 0;">
    <div class="container">
      <div
        style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem;">
        <div>
          <span class="section-badge">मंंडळ कार्यकारिणी डेस्क</span>
          <h1 style="font-size: 2.2rem; color: var(--temple-maroon); margin: 0;">ॲडमिन कंट्रोल पॅनेल</h1>
        </div>
        <div style="display: flex; gap: 0.8rem; align-items: center; flex-wrap: wrap;">
          <form action="/admin/clear-all-data" method="POST" onsubmit="return confirm('Are you sure you want to delete all test entries from Admin Panel and connected Google Sheets?');" style="margin:0;">
            <button type="submit" class="btn btn-outline" style="padding: 0.5rem 1.2rem; font-size: 0.88rem; color: #DC2626; border-color: #FCA5A5;">
              <i class="fa-solid fa-trash-can"></i> सर्व डेटा हटवा (Clear Entries)
            </button>
          </form>
          <a href="/admin/logout" class="btn btn-outline" style="padding: 0.5rem 1.2rem; font-size: 0.88rem;">
            <i class="fa-solid fa-right-from-bracket"></i> लॉगआउट (Logout)
          </a>
        </div>
      </div>

      <!-- Alert Notices -->
      <% if (typeof query.broadcast_success !=='undefined' ) { %>
        <div
          style="background: #D1FAE5; border: 1px solid #6EE7B7; color: #065F46; padding: 1rem; border-radius: 8px; margin-bottom: 2rem;">
          <i class="bi bi-check-circle-fill"></i>
          <%= query.broadcast_success %>
        </div>
        <% } %>

          <!-- Executive Metrics Grid -->

          <div class="grid-3" style="margin-bottom:3rem;">

            <!-- TOTAL DONATIONS -->

            <div class="card-temple" style="text-align:center;">

              <div style="
      font-size:.85rem;
      font-weight:800;
      color:var(--primary-saffron);
      text-transform:uppercase;
    ">
                एकूण देणगी
              </div>

              <div style="
      font-size:2.2rem;
      font-weight:800;
      color:var(--temple-maroon);
      margin:.5rem 0;
    ">

                ₹
                <%= (combinedDonationTotal || 0).toLocaleString('en-IN') %>

              </div>

              <span style="
      font-size:.82rem;
      color:var(--text-muted);
    ">

                Online ₹
                <%= (totalDonations || 0).toLocaleString('en-IN') %>

                  ·

                  Offline ₹
                  <%= (offlineDonationTotal || 0).toLocaleString('en-IN') %>

              </span>

            </div>


            <!-- T-SHIRT BOOKINGS -->

            <div class="card-temple" style="text-align:center;">

              <div style="
      font-size:.85rem;
      font-weight:800;
      color:var(--primary-saffron);
      text-transform:uppercase;
    ">
                T-Shirt Bookings
              </div>

              <div style="
      font-size:2.2rem;
      font-weight:800;
      color:var(--temple-maroon);
      margin:.5rem 0;
    ">

                <%= tshirtOrders.length + offlineTshirtOrders.length %>

              </div>

              <span style="
      font-size:.82rem;
      color:var(--text-muted);
    ">

                Online
                <%= tshirtOrders.length %>

                  ·

                  Offline
                  <%= offlineTshirtOrders.length %>

              </span>

            </div>


            <!-- T-SHIRT REVENUE -->

            <div class="card-temple" style="text-align:center;">

              <div style="
      font-size:.85rem;
      font-weight:800;
      color:var(--primary-saffron);
      text-transform:uppercase;
    ">
                T-Shirt Revenue
              </div>

              <div style="
      font-size:2.2rem;
      font-weight:800;
      color:var(--temple-maroon);
      margin:.5rem 0;
    ">

                ₹
                <%= (combinedTshirtTotal || 0).toLocaleString('en-IN') %>

              </div>

              <span style="
      font-size:.82rem;
      color:var(--text-muted);
    ">

                Online ₹
                <%= (onlineTshirtTotal || 0).toLocaleString('en-IN') %>

                  ·

                  Offline ₹
                  <%= (offlineTshirtTotal || 0).toLocaleString('en-IN') %>

              </span>

            </div>

          </div>


          <!-- EXCEL MANAGEMENT -->

          <div class="card-temple" style="
    margin-bottom:3rem;
    padding:1.5rem;
  ">

            <div style="
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:1rem;
    flex-wrap:wrap;
  ">

              <div>

                <h3 style="
        color:var(--temple-maroon);
        margin:0;
      ">
                  Excel & Offline Records
                </h3>

                <p style="
        margin:.4rem 0 0;
        color:var(--text-muted);
        font-size:.9rem;
      ">
                  Upload committee Excel sheets,
                  view online/offline records and
                  export combined data.
                </p>

              </div>

              <a href="/admin/excel" class="btn btn-primary">

                <i class="fa-solid fa-file-excel"></i>

                Manage Excel & Records

              </a>

            </div>

          </div>

          <!-- Donations Table -->
          <div class="card-temple" style="margin-bottom: 3rem; padding: 2rem;">
            <h3 style="font-size: 1.4rem; color: var(--temple-maroon); margin-bottom: 1.2rem;">
              प्राप्त ऑनलाइन देणगी नोंदी व पडताळणी (Donation Approvals)
            </h3>

            <div style="overflow-x: auto;">
              <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
                <thead>
                  <tr style="background: var(--temple-maroon); color: var(--gold-soft);">
                    <th style="padding: 10px 14px;">पावती क्र.</th>
                    <th style="padding: 10px 14px;">देणगीदाराचे नाव</th>
                    <th style="padding: 10px 14px;">मोबाईल</th>
                    <th style="padding: 10px 14px;">रक्कम (₹)</th>
                    <th style="padding: 10px 14px;">Payment UTR No</th>
                    <th style="padding: 10px 14px;">स्थिती</th>
                    <th style="padding: 10px 14px;">ॲक्शन</th>
                  </tr>
                </thead>
                <tbody>
                  <% donations.forEach(d => { %>
                    <tr style="border-bottom: 1px solid var(--border-subtle);">
                      <td style="padding: 10px 14px; font-weight: 700; font-family: monospace;">
                        <%= d.receipt_no %>
                      </td>
                      <td style="padding: 10px 14px;"><strong>
                          <%= d.donor_name %>
                        </strong>
                        <% if (d.email) { %><br><span style="font-size: 0.8rem; color: var(--text-muted);"><%= d.email %></span><% } %>
                      </td>
                      <td style="padding: 10px 14px;">
                        <%= d.phone %>
                      </td>
                      <td style="padding: 10px 14px; font-weight: 800; color: var(--temple-maroon);">₹ <%=
                          parseFloat(d.amount).toLocaleString('en-IN') %>
                      </td>
                      <td style="padding: 10px 14px; font-family: monospace; font-weight: 700; color: #0F172A;">
                        <%= d.payment_id || d.utr_number || 'N/A' %>
                      </td>
                      <td style="padding: 10px 14px;">
                        <% if (d.status === 'APPROVED' || d.status === 'SUCCESS') { %>
                          <span style="background: #DCFCE7; color: #166534; padding: 4px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: 700;">
                            <i class="bi bi-check-circle-fill"></i> Approved & Emailed
                          </span>
                        <% } else { %>
                          <span style="background: #FEF3C7; color: #92400E; padding: 4px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: 700;">
                            <i class="bi bi-clock-history"></i> Pending Approval
                          </span>
                        <% } %>
                      </td>
                      <td style="padding: 10px 14px;">
                        <% if (d.status === 'APPROVED' || d.status === 'SUCCESS') { %>
                          <a href="/download-receipt/<%= d.receipt_no %>" class="btn btn-outline"
                            style="padding: 4px 12px; font-size: 0.8rem;">
                            <i class="bi bi-file-earmark-pdf-fill"></i> PDF Receipt
                          </a>
                        <% } else { %>
                          <form action="/admin/approve-donation" method="POST" style="display: inline;">
                            <input type="hidden" name="receipt_no" value="<%= d.receipt_no %>">
                            <button type="submit" class="btn btn-primary" style="padding: 4px 12px; font-size: 0.8rem; background: #166534; border: none;" onclick="return confirm('मंजूर करून ईमेलवर पावती पाठवायची आहे का?')">
                              <i class="bi bi-send-check-fill"></i> मंजूर करा व ईमेल पाठवा
                            </button>
                          </form>
                        <% } %>
                      </td>
                    </tr>
                    <% }); %>
                </tbody>
              </table>
            </div>
          </div>

    </div>
  </section>

  <%- include('../partials/footer') %>