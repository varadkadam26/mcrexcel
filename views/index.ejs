      <!-- Animated Stat Counter Row -->
      <div class="grid-3" style="margin-top: 4rem; gap: 1.5rem;">
        <div class="stat-counter-card">
          <div class="stat-num-value" data-target="1929">1929</div>
          <div class="stat-label-text" data-i18n="stat_year_label">Founding Year</div>
        </div>
        <style>
          .border-beam-panel {
            position: relative;
            background: var(--bg-ivory); /* Match card background */
            border-radius: var(--radius-md);
            /* Remove standard border so the beam is visible */
            border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
          }
          
          .border-beam-panel::before {
            content: "";
            position: absolute;
            inset: -2px; /* Ring thickness */
            border-radius: calc(var(--radius-md) + 2px);
            padding: 2px; /* Ring thickness */
            background: conic-gradient(
              from var(--beam-angle, 0deg),
              transparent 0deg,
              color-mix(in srgb, #FFD700 4%, transparent) 55deg,
              #FFD700 70deg,
              #FFF 75deg,
              transparent 78deg,
              transparent 198deg,
              color-mix(in srgb, #FFA500 4%, transparent) 253deg,
              #FFA500 268deg,
              #FFF 273deg,
              transparent 276deg,
              transparent 360deg
            );
            /* Standard mask for border only */
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            mask-composite: exclude;
            pointer-events: none;
            z-index: -1;
            animation: border-beam-spin 8s linear infinite;
          }
          
          .border-beam-panel:hover::before {
            animation-duration: 2s; /* Speed up on hover */
          }
          
          /* The glow effect behind the beam */
          .border-beam-panel::after {
            content: "";
            position: absolute;
            inset: -2px;
            border-radius: calc(var(--radius-md) + 2px);
            background: inherit;
            background: conic-gradient(
              from var(--beam-angle, 0deg),
              transparent 0deg,
              color-mix(in srgb, #FFD700 4%, transparent) 55deg,
              #FFD700 70deg,
              #FFF 75deg,
              transparent 78deg,
              transparent 198deg,
              color-mix(in srgb, #FFA500 4%, transparent) 253deg,
              #FFA500 268deg,
              #FFF 273deg,
              transparent 276deg,
              transparent 360deg
            );
            filter: blur(14px);
            opacity: 0.35;
            z-index: -2;
            pointer-events: none;
            animation: border-beam-spin 8s linear infinite;
          }
          
          .border-beam-panel:hover::after {
            animation-duration: 2s;
          }

          @property --beam-angle {
            syntax: "<angle>";
            initial-value: 0deg;
            inherits: false;
          }

          @keyframes border-beam-spin {
            0% { --beam-angle: 0deg; }
            100% { --beam-angle: 360deg; }
          }
        </style>
        <div class="stat-counter-card border-beam-panel" style="position: relative; z-index: 1;">
          <div class="globe-3d-wrapper">
            <div class="globe-3d-sphere">
              <div class="globe-ring ring-lat-1"></div>
              <div class="globe-ring ring-lat-2"></div>
              <div class="globe-ring ring-long-1"></div>
              <div class="globe-ring ring-long-2"></div>
              <div class="globe-ring ring-long-3"></div>
              <div class="globe-ring ring-equator"></div>
