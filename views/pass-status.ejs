<%- include('partials/header') %>

<!-- Pass Verification Bright Header Banner -->
<section style="background: var(--temple-maroon); padding: 3.5rem 0; text-align: center; border-bottom: 4px solid var(--royal-gold);">
  <div class="container">
    <div style="width: 64px; height: 64px; margin: 0 auto 0.6rem; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3));">
      <img src="/images/logo.png" alt="Mumbai Central Cha Raja Logo" style="width: 100%; height: 100%; object-fit: contain;">
    </div>
    <h1 style="font-family: 'Rozha One', 'Noto Sans Devanagari', serif; font-size: 3.2rem; color: #FFFFFF; font-weight: 800; margin: 0;" data-i18n="verify_form_title">
      व्हीआयपी पास पडताळणी 🔍
    </h1>
    <p style="color: #FFF5E6; font-size: 0.95rem; margin-top: 0.5rem;" data-i18n="verify_form_sub">
      तुमचा पास टोकन नंबर किंवा नोंदणीकृत मोबाईल नंबर टाकून पास तपासा.
    </p>
  </div>
</section>

<section class="py-5" style="background: var(--bg-surface); min-height: 60vh;">
  <div class="container">

    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
      <div style="background: #D1FAE5; border: 1px solid #6EE7B7; color: #065F46; padding: 1rem; border-radius: 8px; max-width: 650px; margin: 0 auto 2rem; text-align: center;">
        <i class="bi bi-check-circle-fill"></i> <%= successMessage %>
      </div>
    <% } %>

    <!-- Search Form Box -->
    <div style="max-width: 600px; margin: 0 auto 3rem;">
      <form action="/pass-status" method="GET" class="search-form-resp" style="display: flex; gap: 0.8rem;">
        <input type="text" name="code" class="form-control" placeholder="उदा. MCC-2026-89412 किंवा 9876543210" data-i18n="ph_token_input" value="<%= searchCode %>" required style="flex: 1;">
        <button type="submit" class="btn btn-chintamani-primary">
          <i class="bi bi-search"></i> <span data-i18n="btn_verify_now">पासची स्थिती तपासा</span>
        </button>
      </form>
    </div>

    <!-- Pass Ticket Display Card -->
    <% if (pass) { %>
      <div class="pass-ticket-card" style="max-width: 750px; margin: 0 auto; background: var(--bg-card); border: 2px solid var(--chintamani-red); border-radius: var(--radius-lg); padding: 2rem; box-shadow: var(--shadow-lg);">
        <div class="ticket-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--border-light); padding-bottom: 1rem; margin-bottom: 1.5rem;">
          <div style="display: flex; align-items: center; gap: 1rem;">
            <div style="width: 58px; height: 58px; border-radius: 50%; overflow: hidden; border: 2px solid var(--chintamani-gold); box-shadow: var(--shadow-sm); flex-shrink: 0;">
              <img src="<%= pass.photo_url || '/images/logo.png' %>" alt="Devotee Passport Photo" style="width: 100%; height: 100%; object-fit: cover;">
            </div>
            <div>
              <span style="font-size: 0.8rem; color: var(--chintamani-red); text-transform: uppercase; font-weight: 800;">Official VIP Entry Pass</span>
              <h3 style="margin-top: 0.2rem; font-size: 1.4rem; color: var(--text-main);"><%= pass.full_name %></h3>
            </div>
          </div>
          <div class="pass-code-badge" style="background: var(--chintamani-red); color: #FFD700; font-weight: 800; padding: 0.4rem 1rem; border-radius: var(--radius-sm); font-size: 1.1rem;">
            <%= pass.pass_code %>
          </div>
        </div>

        <div class="form-grid-2" style="margin-bottom: 2rem;">
          <div>
            <span style="font-size: 0.8rem; color: var(--text-muted); display: block;">MOBILE PHONE</span>
            <strong style="color: var(--text-main);"><%= pass.phone %></strong>
          </div>
          <div>
            <span style="font-size: 0.8rem; color: var(--text-muted); display: block;">AGE & GENDER</span>
            <strong style="color: var(--text-main);"><%= pass.age %> Yrs / <%= pass.gender %></strong>
          </div>
          <div>
            <span style="font-size: 0.8rem; color: var(--text-muted); display: block;">CITY / AREA</span>
            <strong style="color: var(--text-main);"><%= pass.city %></strong>
          </div>
          <div>
            <span style="font-size: 0.8rem; color: var(--text-muted); display: block;">ID PROOF</span>
            <strong style="color: var(--text-main);"><%= pass.id_proof_type %> (<%= pass.id_proof_number %>)</strong>
          </div>
          <div style="grid-column: span 2;">
            <span style="font-size: 0.8rem; color: var(--text-muted); display: block;">ENTRY CATEGORY / BATCH</span>
            <strong style="color: var(--chintamani-red); font-size: 1.05rem;"><%= pass.batch %></strong>
          </div>
          <div>
            <span style="font-size: 0.8rem; color: var(--text-muted); display: block;">EMERGENCY CONTACT</span>
            <strong style="color: var(--accent-red);"><%= pass.emergency_contact %></strong>
          </div>
          <div>
            <span style="font-size: 0.8rem; color: var(--text-muted); display: block;">PASS STATUS</span>
            <span style="display: inline-block; background: var(--accent-green-bg); color: var(--accent-green); padding: 0.2rem 0.6rem; border-radius: 4px; font-weight: 700; font-size: 0.85rem;">
              ✓ <%= pass.status %>
            </span>
          </div>
        </div>

        <div style="border-top: 1px solid var(--border-light); padding-top: 1.5rem; text-align: center;">
          <a href="/download-pass/<%= pass.pass_code %>" class="btn btn-chintamani-primary" style="padding: 0.8rem 2rem;">
            <i class="bi bi-file-earmark-pdf-fill"></i> Download Official PDF Gate Pass
          </a>
        </div>
      </div>
    <% } else if (searched) { %>
      <div style="text-align: center; max-width: 500px; margin: 0 auto; padding: 2rem; background: #FFFFFF; border-radius: 12px; border: 1px solid var(--border-light);">
        <i class="bi bi-search-heart" style="font-size: 3rem; color: var(--text-muted);"></i>
        <h3 style="margin-top: 1rem; color: var(--text-main);">No Pass Record Found</h3>
        <p style="color: var(--text-muted); margin-bottom: 1.5rem;">We couldn't find a pass matching "<%= searchCode %>". Please verify your registration code or mobile number.</p>
        <a href="/register-pass" class="btn btn-chintamani-primary">Register New Pass &rarr;</a>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
