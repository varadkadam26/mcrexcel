<%- include('partials/header') %>

<section style="background: var(--temple-maroon); color: var(--bg-ivory); padding: 4.5rem 0; border-bottom: 3px solid var(--royal-gold); text-align: center;">
  <div class="container">
    <span class="section-badge" style="background: rgba(212, 175, 55, 0.2); color: var(--gold-soft); border-color: var(--royal-gold);">
      उत्सव कार्यसूची
    </span>
    <h1 style="font-size: 3rem; color: var(--gold-soft); margin-top: 0.5rem;" data-i18n="schedule_page_title">१० दिवसांचे गणेशोत्सव वेळापत्रक</h1>
    <p style="font-size: 1.15rem; color: #E5E7EB; max-width: 750px; margin: 1rem auto 0; line-height: 1.8;" data-i18n="schedule_page_sub">
      दैनिक पूजा, महाआरती, भक्ती संध्या आणि विसर्जन मिरवणूक पूर्ण वेळापत्रक.
    </p>
  </div>
</section>

<section style="background: var(--bg-cream); padding: 5rem 0;" class="reveal-on-scroll">
  <div class="container">
    
    <div style="display: flex; flex-direction: column; gap: 2rem;">
      <% scheduleData.forEach(evt => { %>
        <div class="card-temple reveal-on-scroll" style="display: flex; gap: 2rem; align-items: center; flex-wrap: wrap;">
          <div style="background: var(--temple-maroon); color: var(--gold-soft); padding: 1.5rem 2rem; border-radius: var(--radius-md); text-align: center; min-width: 140px; border: 2px solid var(--royal-gold);">
            <span style="font-size: 0.8rem; font-weight: 800; text-transform: uppercase;">दिवस</span>
            <h2 style="font-size: 2.5rem; color: var(--gold-soft); margin: 0; line-height: 1;"><%= evt.day %></h2>
          </div>

          <div style="flex: 1;">
            <span style="font-size: 0.8rem; font-weight: 800; color: var(--primary-saffron); text-transform: uppercase; background: var(--saffron-light); padding: 3px 10px; border-radius: 4px;">
              <%= evt.date %>
            </span>
            <h3 style="font-size: 1.6rem; color: var(--temple-maroon); margin: 0.4rem 0 0.6rem;"><%= evt.title %></h3>
            
            <p style="color: var(--text-muted); font-size: 0.98rem; margin-bottom: 1rem;">
              <i class="fa-solid fa-location-dot" style="color: var(--primary-saffron); margin-right: 6px;"></i> <%= evt.halt_location %>
            </p>

            <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
              <% evt.facilities.forEach(fac => { %>
                <span style="font-size: 0.82rem; background: var(--bg-surface); border: 1px solid var(--border-gold); padding: 4px 12px; border-radius: var(--radius-full); font-weight: 600;">
                  <%= fac %>
                </span>
              <% }); %>
            </div>
          </div>
        </div>
      <% }); %>
    </div>

  </div>
</section>

<%- include('partials/footer') %>
