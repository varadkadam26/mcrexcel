<%- include('partials/header') %>

  <section class="page-hero-banner">
    <div class="container">
      <span class="section-badge" data-i18n="social_section_tag">
        समाजोपयोगी उपक्रम
      </span>
      <h1 data-i18n="social_section_title">सामाजिक कार्य व उपक्रम</h1>
      <p data-i18n="social_section_sub">
        अन्नदान महाप्रसाद, रक्तदान शिबीर, मोफत आरोग्य तपासणी आणि शैक्षणिक मदतीतून समाजसेवा.
      </p>
    </div>
  </section>

  <section style="background: var(--bg-cream); padding: 5rem 0;">
    <div class="container">
      <div style="display: flex; flex-direction: column; gap: 3.5rem;">
        <% socialWorkData.forEach((work, idx)=> { %>
          <div
            style="background: var(--bg-white); border-radius: var(--radius-lg); border: 1px solid var(--border-gold); padding: 2.5rem; box-shadow: var(--shadow-md); display: flex; flex-direction: <%= idx % 2 === 0 ? 'row' : 'row-reverse' %>; gap: 2.5rem; align-items: center; flex-wrap: wrap;">

            <div style="flex: 1; min-width: 300px;">
              <span
                style="font-size: 0.82rem; font-weight: 800; color: var(--primary-saffron); text-transform: uppercase; background: var(--saffron-light); padding: 4px 12px; border-radius: var(--radius-full);">
                <span class="lang-en"><%= work.categoryEn %></span>
                <span class="lang-mr"><%= work.categoryMr %></span>
              </span>
              <h2 style="font-size: 1.9rem; color: var(--temple-maroon); margin: 0.8rem 0 1rem;">
                <span class="lang-en"><%= work.titleEn %></span>
                <span class="lang-mr"><%= work.titleMr %></span>
              </h2>
              <p style="color: var(--text-muted); font-size: 1.05rem; line-height: 1.9; margin-bottom: 1.5rem;">
                <span class="lang-en"><%= work.descEn %></span>
                <span class="lang-mr"><%= work.descMr %></span>
              </p>
            </div>

            <div
              style="flex: 1; min-width: 300px; border-radius: var(--radius-md); overflow: hidden; border: 3px solid var(--royal-gold); box-shadow: var(--shadow-sm);">
              <img src="<%= work.image %>" alt="<%= work.titleEn %>"
                style="width: 100%; height: auto; display: block;">
            </div>
          </div>
          <% }); %>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>