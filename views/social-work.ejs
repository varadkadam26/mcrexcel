<%- include('partials/header') %>

  <section class="page-hero-banner">
    <div class="container">
      <span class="section-badge" data-i18n="social_section_tag">
        समाजोपयोगी उपक्रम
      </span>
      <h1 data-i18n="social_section_title">सामाजिक कार्य व उपक्रम</h1>
      <p data-i18n="social_section_sub">
        रक्तदान शिबीर, मोफत आरोग्य तपासणी, वैद्यकीय मदत आणि शैक्षणिक मदतीतून समाजसेवा.
      </p>
    </div>
  </section>

  <style>
    .social-work-item {
      background: var(--bg-white);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border-gold);
      padding: 2.5rem;
      box-shadow: var(--shadow-md);
      display: flex;
      gap: 2.5rem;
      align-items: center;
    }
    .social-work-content {
      flex: 1;
      min-width: 300px;
    }
    .social-work-title {
      font-size: clamp(1.2rem, 3vw, 1.5rem);
      color: var(--temple-maroon);
      margin: 0.8rem 0 1rem;
      line-height: 1.4;
      /* removed nowrap to allow wrapping on mobile */
    }
    .social-work-img-container {
      flex: 1; 
      min-width: 300px; 
      border-radius: var(--radius-md); 
      overflow: hidden; 
      border: 3px solid var(--royal-gold); 
      box-shadow: var(--shadow-sm);
    }
    .social-work-img-container img {
      width: 100%;
      height: 100%;
      max-height: 350px;
      object-fit: cover;
      object-position: center;
      display: block;
    }
    
    @media (max-width: 768px) {
      .social-work-item {
        flex-direction: column !important;
        padding: 1.5rem;
        gap: 1.5rem;
      }
      .social-work-content, .social-work-img-container {
        min-width: 100%;
      }
    }
  </style>
  <section style="background: var(--bg-cream); padding: 5rem 0;">
    <div class="container">
      <div style="display: flex; flex-direction: column; gap: 3.5rem;">
        <% socialWorkData.forEach((work, idx)=> { %>
          <div class="social-work-item" style="flex-direction: <%= idx % 2 === 0 ? 'row' : 'row-reverse' %>;">
            <div class="social-work-content">
              <span
                style="font-size: 0.82rem; font-weight: 800; color: var(--primary-saffron); text-transform: uppercase; background: var(--saffron-light); padding: 4px 12px; border-radius: var(--radius-full);">
                <span class="lang-en"><%= work.categoryEn %></span>
                <span class="lang-mr"><%= work.categoryMr %></span>
              </span>
              <h2 class="social-work-title">
                <span class="lang-en"><%= work.titleEn %></span>
                <span class="lang-mr"><%= work.titleMr %></span>
              </h2>
              <p style="color: var(--text-muted); font-size: 1.05rem; line-height: 1.9; margin-bottom: 0;">
                <span class="lang-en"><%= work.descEn %></span>
                <span class="lang-mr"><%= work.descMr %></span>
              </p>
            </div>

            <div class="social-work-img-container">
              <img src="<%= work.image %>" alt="<%= work.titleEn %> - Mumbai Central Cha Raja Social Work Seva" loading="lazy" decoding="async">
            </div>
          </div>
          <% }); %>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>