<%- include('partials/header') %>

<section style="background: var(--temple-maroon); color: var(--bg-ivory); padding: 4.5rem 0; border-bottom: 3px solid var(--royal-gold); text-align: center;">
  <div class="container">
    <span class="section-badge" style="background: rgba(212, 175, 55, 0.2); color: var(--gold-soft); border-color: var(--royal-gold);">
      समाजोपयोगी उपक्रम
    </span>
    <h1 style="font-size: 3rem; color: var(--gold-soft); margin-top: 0.5rem;" data-i18n="socialwork_title">सामाजिक कार्य व उपक्रम</h1>
    <p style="font-size: 1.15rem; color: #E5E7EB; max-width: 750px; margin: 1rem auto 0; line-height: 1.8;" data-i18n="socialwork_sub">
      अन्नदान महाप्रसाद, रक्तदान शिबीर, मोफत आरोग्य तपासणी आणि शैक्षणिक मदतीतून समाजसेवा.
    </p>
  </div>
</section>

<section style="background: var(--bg-cream); padding: 5rem 0;">
  <div class="container">
    <div style="display: flex; flex-direction: column; gap: 3.5rem;">
      <% socialWorkData.forEach((work, idx) => { %>
        <div style="background: var(--bg-white); border-radius: var(--radius-lg); border: 1px solid var(--border-gold); padding: 2.5rem; box-shadow: var(--shadow-md); display: flex; flex-direction: <%= idx % 2 === 0 ? 'row' : 'row-reverse' %>; gap: 2.5rem; align-items: center; flex-wrap: wrap;">
          
          <div style="flex: 1; min-width: 300px;">
            <span style="font-size: 0.82rem; font-weight: 800; color: var(--primary-saffron); text-transform: uppercase; background: var(--saffron-light); padding: 4px 12px; border-radius: var(--radius-full);">
              <%= work.category %>
            </span>
            <h2 style="font-size: 1.9rem; color: var(--temple-maroon); margin: 0.8rem 0 1rem;"><%= work.title %></h2>
            <p style="color: var(--text-muted); font-size: 1.05rem; line-height: 1.9; margin-bottom: 1.5rem;"><%= work.desc %></p>
            
            <a href="/donate" class="btn btn-outline" style="font-weight: 700;">
              या कार्यात सहभाग घ्या / देणगी द्या <i class="bi bi-heart-fill" style="color: var(--temple-maroon);"></i>
            </a>
          </div>

          <div style="flex: 1; min-width: 300px; height: 320px; border-radius: var(--radius-md); overflow: hidden; border: 3px solid var(--royal-gold); box-shadow: var(--shadow-sm);">
            <img src="<%= work.image %>" alt="<%= work.title %>" style="width: 100%; height: 100%; object-fit: cover;">
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
